# Redis the ingest service publishes to (redis:// or rediss://)
REDIS_URL=redis://localhost:6379
# Ingest control server (POST /subscriptions); INGEST_TOKEN must match ingest's
INGEST_URL=http://localhost:3003
INGEST_TOKEN=change-me
PORT=3002
# Socket.IO ticks are served on the same port; POST /subscriptions asks ingest
# to start streaming any valid symbol (e.g. AAPL, EUR/USD, RY:TSX).
