# Redis the ingest service publishes to (redis:// or rediss://)
REDIS_URL=redis://localhost:6379
# Comma-separated allow-list of symbols, same variable as ingest.
# Use TwelveData's canonical casing (e.g. EUR/USD, RY:TSX): ingest keys Redis by it.
SYMBOLS=AAPL,EUR/USD
PORT=3002
# WebSocket ticks are served at ws://localhost:$PORT/ws (JSON frames, raw ws).
# Client: {"type":"subscribe","symbols":["AAPL"]} (max 8 per connection, must be in SYMBOLS).
# Server: snapshot -> subscribed -> tick frames; see @repo/shared ws types.
