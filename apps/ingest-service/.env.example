# TwelveData API key
TWELVEDATA_API_KEY=your-api-key

# ws streams ticks into the ticks table; rest polls quotes into the quotes table
FEED_MODE=ws
# Pinned symbols: always subscribed and never removed (comma-separated)
SYMBOLS=AAPL
# rest mode only: polling interval
# POLL_INTERVAL_MS=60000

# Redis to publish ticks to (redis:// or rediss://)
REDIS_URL=redis://localhost:6379

# DynamoDB (Floci locally). Table names come from infra: <project>-<env>-ticks / -quotes
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
TICKS_TABLE_NAME=stock-viewer-local-ticks
# rest mode only
# DYNAMODB_TABLE_NAME=stock-viewer-local-quotes

# ws mode only: control server the API calls to subscribe to any symbol
# (POST /subscriptions). INGEST_TOKEN must match the API's.
INGEST_TOKEN=change-me
# CONTROL_PORT=3003
# Total symbols, pinned + dynamic; new ones are rejected beyond this (free tier: 8)
# MAX_SYMBOLS=8
# Dynamic symbols not requested for this long are unsubscribed
# IDLE_TTL_MS=600000
